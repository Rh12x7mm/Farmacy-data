#проверка на отсутствие сотрудников и чеков в филиалах
SELECT p.branch_id, p.city

(SELECT COUNT(*) FROM employee e WHERE e.branch_id = p.branch_id) AS employees,

(SELECT COUNT(*) FROM receipt r WHERE r.branch_id = p.branch_id) AS receipts

FROM pharmacy_branch p

ORDER BY p.branch_id; 


#проверка сотрудников без чека
SELECT e.employee_id, e.last_name, e.position, e.branch_id

FROM employee e LEFT JOIN receipt r ON r.employee_id = e.employee_id

WHERE r.receipt_id IS NULL;
